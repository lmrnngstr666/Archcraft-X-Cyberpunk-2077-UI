/*****----- Configuration -----*****/
configuration {
    show-icons:                 false;
}

/*****----- Global Properties -----*****/
@import                          "shared/colors.rasi"
@import                          "shared/fonts.rasi"

* {
    border-colour:               var(selected);
    handle-colour:               var(selected);
    background-colour:           transparent;
    foreground-colour:           var(foreground);
    alternate-background:        transparent;
    normal-background:           transparent;
    normal-foreground:           var(foreground);
    urgent-background:           transparent;
    urgent-foreground:           var(background);
    active-background:           transparent;
    active-foreground:           var(background);
    selected-normal-background:  var(selected);
    selected-normal-foreground:  var(background);
    selected-urgent-background:  var(active);
    selected-urgent-foreground:  var(background);
    selected-active-background:  var(urgent);
    selected-active-foreground:  var(background);
    alternate-normal-background: transparent;
    alternate-normal-foreground: var(foreground);
    alternate-urgent-background: transparent;
    alternate-urgent-foreground: var(background);
    alternate-active-background: transparent;
    alternate-active-foreground: var(background);
}

/*****----- Main Window -----*****/
window {
    /* properties for window widget */
    transparency:                "real";
    location:                    center;
    anchor:                      center;
     fullscreen:                 false;
    width:                       620px;
    height:                      480px;
    x-offset:                    0px;
    y-offset:                    0px;

    /* properties for all widgets */
    enabled:                     true;
    margin:                      0px;
    padding:                     0px;
    border:                      0px solid;
    border-radius:               10px;
    border-color:                @border-colour;
    cursor:                      "default";
    /* Backgroud Colors */
    background-color:            transparent;
}

/*****----- Main Box -----*****/
mainbox {
    enabled:                     true;
    spacing:                     10px;
    margin:                      0px;
    padding:                     0px;
    border:                      0px solid;
    border-radius:               0px 0px 0px 0px;
    border-color:                @border-colour;
    background-color:            transparent;
     background-image:            url("/home/mrnngstr666/.config/rofi/user-interfces/cyberpunk/network/net-main.png", width);
   
    children:                    ["inputbar", "listview"];
}

/*****----- Inputbar -----*****/
inputbar {
    enabled:                     true;
    spacing:                     0px;
    margin:                      0px;
    padding:                     5px 0px 0px 390px;
    border:                      0px solid;
    border-radius:               0px;
    border-color:                @border-colour;
    background-color:            transparent;
    text-color:                  @foreground-colour;
    children:                    [ "textbox-prompt-colon", "prompt", "entry" ];
}

prompt {
    enabled:                     false;
    padding:                     8px 12px;
    border-radius:               100%;
    background-color:            @selected;
    text-color:                  transparent;
}
textbox-prompt-colon {
    enabled:                     true;
    padding:                     8px 10px;
    border-radius:               100%;
    expand:                      false;
    str:                         "";
    background-color:            transparent;
    text-color:                  transparent;
}
entry {
    enabled:                     false;
    padding:                     8px 0px;
    border-radius:               100%;
    background-color:            transparent;
    font: "Rajdhani Seminold 14";
    text-color:                  inherit;
    cursor:                      text;
      border:                     0px 0px 0px 0px solid;
    border-radius:               0px;
    border-color:                @border-colour;
    placeholder:                 "  ";
    placeholder-color:           inherit;
}
num-filtered-rows {
    enabled:                     true;
    expand:                      false;
    background-color:            inherit;
    text-color:                  inherit;
}
textbox-num-sep {
    enabled:                     true;
    expand:                      false;
    str:                         "/";
    background-color:            inherit;
    text-color:                  inherit;
}
num-rows {
    enabled:                     true;
    expand:                      false;
    background-color:            inherit;
    text-color:                  inherit;
}
case-indicator {
    enabled:                     true;
    background-color:            inherit;
    text-color:                  inherit;
}

/*****----- Listview -----*****/
listview {
    enabled:                     true;
    columns:                     1;
    lines:                       7;
    cycle:                       true;
    dynamic:                     true;
    scrollbar:                   true;
    layout:                      vertical;
    reverse:                     false;
    fixed-height:                true;
    fixed-columns:               true;
    spacing:                     5px;
    margin:                      23px 0px 14px 35px;
    padding:                     0px 14px 0px 0px;
    border:                      0px solid;
    border-radius:               0px;
    border-color:                @border-colour;
    background-color:            transparent;
    text-color:                  @foreground-colour;
    cursor:                      "default";
}
scrollbar {
    handle-width:                5px ;
    handle-color:                @handle-colour;
    border-radius:               10px;
    background-color:            @alternate-background;
}

/*****----- Elements -----*****/
element {
    enabled:                     true;
    padding:                     20px 0px 13px 10px;
    border:                      0px solid;
    border-radius:               0px;
    font: "Rajdhani 12";
    border-color:                #368fa7;
    background-color:            transparent;
    text-color:                  @foreground;
    cursor:                      pointer;
}
element-text {
    background-color:            transparent;
    font: "Rajdhani Semibold 12";
    text-color:                  #76f8ff;
    cursor:                      inherit;
    vertical-align:              0.5;
    horizontal-align:            0.0;
}
 
scrollbar {
    handle-width:                4px ;
    handle-color:                #e7655f;
    border-radius:               10px;
    margin: -7px 0px 0px 0px;
    background-color:            #050302;
}
/*****----- Elements -----*****/
element-icon {
    enabled:                     true;
    str:                         "🎵";  /* Default icon */
    padding:                     5px;
    border:                      0px;
    border-radius:               0px;
    background-color:            transparent;
    text-color:                  @foreground;
    font:                       "Noto Sans 12";  /* Ensure this font supports the icon */
}
element normal.normal,
element alternate.normal {
   background-color:            transparent;
    text-color:                  #355d75;
    background-image:            url("/home/mrnngstr666/.config/rofi/user-interfces/cyberpunk/network/net-seln.png", width);

    font: "Rajdhani 12";
    border-color:#1c2c2c;
    border:0px solid;
}
element normal.urgent,
element alternate.urgent,
element selected.active {
    font: "Orpheis 12";
    background-color:            transparent;
       text-color:                    #76f8ff;
        border-color:#1c2c2c;
    border:1px solid;

}
element normal.active,
element alternate.active,
element selected.urgent {
    font: "Orpheis 12";
    background-color:            transparent;
    text-color:                    #76f8ff;
 border:                        2px solid;
    border-color:                #368fa7;
    border-radius:                  0px;
}
element selected.normal {
    background-color:            transparent;
    background-image:            url("/home/mrnngstr666/.config/rofi/user-interfces/cyberpunk/network/net-sel.png", width);
    text-color:                    #76f8ff;
    padding:40px 0px 0px 0px ;
    border:                        0px solid;
    font: "Orpheis 12";
    border-color:                #368fa7;
    border-radius:                  0px;
}
/*****----- Mode Switcher -----*****/
mode-switcher{
    enabled:                     true;
    spacing:                     10px;
    margin:                      0px;
    padding:                     0px;
    border:                      0px solid;
    border-radius:               0px;
    border-color:                @border-colour;
    background-color:            transparent;
    text-color:                  @foreground-colour;
}
button {
    padding:                     5px 10px;
    border:                      0px solid;
    border-radius:               8px;
    border-color:                @border-colour;
    background-color:            @alternate-background;
    text-color:                  inherit;
    cursor:                      pointer;
}
button selected {
    background-color:            var(selected-normal-background);
    text-color:                  var(selected-normal-foreground);
}

/*****----- Message -----*****/
message {
    enabled:                     true;
    margin:                      0px;
    padding:                     8px 10px;
    border:                      0px solid;
    border-radius:               8px;
    border-color:                @border-colour;
    background-color:            @alternate-background;
    text-color:                  @foreground-colour;
}
textbox {
    border:                      0px solid;
    border-color:                @border-colour;
    background-color:            transparent;
    text-color:                  @foreground-colour;
    vertical-align:              0.5;
    horizontal-align:            0.0;
    highlight:                   none;
    placeholder-color:           @foreground-colour;
    blink:                       true;
    markup:                      true;
}
error-message {
    padding:                     15px;
    border:                      0px solid;
    border-radius:               10px;
    border-color:                @border-colour;
    background-color:            @background-colour;
    text-color:                  @foreground-colour;
}

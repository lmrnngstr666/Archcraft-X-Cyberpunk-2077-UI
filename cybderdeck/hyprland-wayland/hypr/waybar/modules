{
  "pulseaudio": {
    "format": "{volume}",
    "format-muted": " 0",
    "format-bluetooth": " {volume}% {format_source}",
    "format-bluetooth-muted": " Mute",
    "format-source": " {volume}%",
    "format-source-muted": "",
    "format-icons": {
      "headphone": "",
      "hands-free": "",
      "headset": "",
      "phone": "",
      "portable": "",
      "car": "",
      "default": [
        "",
        "",
        ""
      ]
    },
    "scroll-step": 5,
    "on-click": "pulsemixer --toggle-mute",
    "on-click-right": "pulsemixer --toggle-mute",
    "smooth-scrolling-threshold": 1
  },
  "pulseaudio/slider": {
    "menit": 0,
    "maks": 100,
    "orientasi": "horizontal"
  },
  "backlight": {
    "interval": 2,
    "align": 0,
    "rotate": 0,
    "format": "{percent}",
    "format-icons": [
      "",
      "",
      "",
      ""
    ],
    "on-click": "",
    "on-click-middle": "",
    "on-click-right": "",
    "on-update": "",
    "on-scroll-up": "light -A 5%",
    "on-scroll-down": "light -U 5%",
    "smooth-scrolling-threshold": 1
  },
  "backlight/slider": {
    "min": 0,
    "max": 100,
    "orientation": "horizontal",
    "device": "intel_backlight"
  },
  "custom/cpuid": {
    "format": "󰛯 ",
    "tooltip": false
  },
  "cpu": {
    "interval": 5,
    "format": "{usage} /"
  },
  "custom/str": {
    "format": "$TR",
    "tooltip": false
  },
  "disk": {
    "interval": 30,
    "format": "{free}"
  },
  "memory": {
    "interval": 10,
    "format": "{used:0.3f}"
  },
  "hyprland/workspaces": {
    "format": "{icon}",
    "sort-by-number": true,
    "active-only": false,
    "persistent-workspaces": {
      "*": [
        1,
        2,
        3,
        4,
        5
      ]
    },
    "format-icons": {
      "1": "󱥐  CYBERWARE",
      "2": "󰜫  INVENTORY",
      "3": "  CRAFTING",
      "4": "  MEDIA",
      "5": "󰧭  JOURNAL",
      "6": "󰫅  MESSAGE",
      "7": "󰓸  CYBERWEB",
      "8": "  CODE",
      "urgent": "",
      "focused": "",
      "default": ""
    },
    "on-click": "activate"
  }
}

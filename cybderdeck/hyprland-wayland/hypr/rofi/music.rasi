/*****----- Configuration -----*****/
configuration {
    show-icons:                 false;
}

/*****----- Global Properties -----*****/
@import                          "shared/colors.rasi"
@import                          "shared/fonts.rasi"

/*
USE_ICON=NO
*/

/*****----- Main Window -----*****/
window {
   transparency:                "real";
    location:                    northeast;
    anchor:                      southeast;
    fullscreen:                  false;
    width:                       500px;
    height:                      248px;
    x-offset:                    -30px;
    y-offset:                    20px;
    margin:                      0px;
    padding:                     0px;
    border:                      0px solid;
    border-radius:               0px;
    border-color:                @selected;
    cursor:                      "default";
    //background-color:          #862f2e34;
	background-color:            transparent;
}

/*****----- Main Box -----*****/
mainbox {
    enabled:                     true;
    spacing:                     0px;
    margin:             		 0px;
    padding:                     30px 0px 0px 0px;
    background-image:            url("~/.config/hypr/rofi/shared/radio-bg.png", width);
    background-color:            transparent;
    children:                    [ "listview" ];
}

/*****----- Inputbar -----*****/
inputbar {
    enabled:                     true;
    spacing:                     0px;
    padding:                     0px 0px 0px 0px;
    border:                      0px;
    border-radius:               0px;
    margin:                      0px;
    border-color:                @selected;
    background-color:            transparent;
    text-color:                  @foreground;
    children:                    [ "textbox-prompt-colon", "prompt"];
}

textbox-prompt-colon {
    enabled:                     false;
    expand:                      false;
    str:                         "png image";
    padding:                     0px 0px 0px 0px;
    border:                      0px;
    margin:                      0px;
    border-radius:               0px;
    border-color:                @selected;
    background-color:            transparent;
    text-color:                  transparent;
}
prompt {
    enabled:                     true;
    padding:                     0px 0px 0px 0px;
    margin:                      204px 0px 0px 59px;
    font:                        "rajdhani bold 7";
    border:                      0px;
    border-radius:               0px;
    border-color:                @selected;
    background-color:            transparent;
 text-color:                #fe6760;
}

/*****----- Message -----*****/
message {
    enabled:                     true;
    margin:                      0px;
    padding:                     0px; 
    font:                        "Rajdhani bold 12";
    border-radius:               0px;
    border:                      0px solid;
    border-color:                @selected;
    background-color:            transparent; 
    text-color:                  #75f3fb;
}
textbox {
    background-color:            inherit;
    text-color:                  inherit;
    vertical-align:              0.5;
    horizontal-align:            0.0;
}

/*****----- Listview -----*****/
listview {
    enabled:                     true;
    font:                        "Rajdhani 12";
    columns:                     1;
    lines:                       6;
    cycle:                       true;
    scrollbar:                   true;
    layout:                      vertical;
    spacing:                     10px;
    border-radius:               0px;
    margin:                      20px 5px 38px 200px;
    padding:                     0px 0px 0px 0px;
    border:                      0px solid;
    border-color:                @selected;
    background-color:            transparent; 
    cursor:                      "default"; 
}

/*****----- Elements -----*****/
element {
    enabled:                     true;
    padding:                     2px 0px 0px 35px;
    border:                      0px solid;
    border-radius:               0px; 
    border-color:                #368fa7;
    background-color:            transparent;
    text-color:                  @foreground;
    cursor:                      pointer;
}
element-text {
    background-color:            transparent;
    font:  						 "Rajdhani medium 9";
    text-color:                  inherit;
    cursor:                      inherit;
    vertical-align:              0.5;
    horizontal-align:            0.0;
}
 
scrollbar {
    handle-width:                3px ;
    handle-color:                #fe6760;
    border-radius:               10px;
    margin: 					 -7px 0px 0px 0px;
    background-color:            #050302;
}
/*****----- Elements -----*****/
element-icon {
    enabled:                     true; 
    padding:                     5px;
    border:                      0px;
    border-radius:               0px;
    background-color:            transparent;
    text-color:                  @foreground;
 }

element normal.normal {
    background-color:            transparent;
    background-image:            url("~/.config/hypr/rofi/shared/radio-seln.png", width);
    text-color:                  #fe6760;
}
element normal.urgent {
    background-color:            transparent;
    text-color:                  #fe6760;
}

element normal.active {
    background-color:            transparent;
    text-color:                  #fe6760;
}

element selected.normal {
    background-color:            transparent;
    background-image:            url("~/.config/hypr/rofi/shared/radio-sel.png", width);
    text-color:                  #000000;
}

element selected.urgent {
    background-color:            transparent;
    background-image:            url("~/.config/hypr/rofi/shared/radio-sel.png", width);
    text-color:                  #000000;
}

element selected.active {
    background-color:            transparent;
    background-image:            url("~/.config/hypr/rofi/shared/radio-sel.png", width);
    text-color:                  #000000;
}

element alternate.normal {
    background-color:            transparent;
    background-image:            url("~/.config/hypr/rofi/shared/radio-seln.png", width);
    text-color:                  #fe6760;
}

element alternate.urgent {
    background-color:            transparent;
    text-color:                  #fe6760;
}

element alternate.active {
    background-color:            transparent;
    text-color:                  #fe6760;
}


/*****----- Configuration -----*****/
configuration {
    show-icons:                 false;
}

/*****----- Global Properties -----*****/
@import                          "shared/colors.rasi"
@import                          "shared/fonts.rasi"

/*
USE_ICON=YES
*/

/*****----- Main Window -----*****/
window {
    transparency:                "real";
    location:                    northeast;
    anchor:                      north;
    fullscreen:                  false;
    width:                       400px;
    height:                       122px;
    x-offset:                    -25px;
    y-offset:                    25px;
    margin:                      0px;
    padding:                     0px;
    border:                      0px solid;
    border-radius:               0px;
    border-color:                @background-alt;
    cursor:                      "default";
    background-image:            url("~/.config/hypr/rofi/shared/power-bg.png", width);
    background-color:            transparent;
}

/*****----- Main Box -----*****/
mainbox {
    enabled:                     true;
    spacing:                     20px;
    margin:                      0px;
    padding:                     4px 14px 4px 20px;
    background-color:            transparent;
    children:                    [ "message", "listview" ];
}

/*****----- Inputbar -----*****/
inputbar {
    enabled:                     true;
    spacing:                     10px;
    padding:                     0px;
    border:                      0px;
    border-radius:               0px;
    border-color:                @selected;
    background-color:            transparent;
    text-color:                  @foreground;
    children:                    [ "textbox-prompt-colon", "prompt"];
}

textbox-prompt-colon {
    enabled:                     true;
    expand:                      false;
    str:                         "";
    padding:                     10px 14px;
    border-radius:               12px;
    background-color:            var(urgent);
    text-color:                  @background;
}
prompt {
    enabled:                     true;
    padding:                     10px;
    border-radius:               12px; 
    background-color:            var(active);
    text-color:                  @background;
}

/*****----- Message -----*****/
message {
    enabled:                     true;
    margin:                      0px;
    padding:                     27px 0px 0px 48px;
    border:                      0px solid;
    border-radius:               0px;
    font:                        "Rajdhani bold 8";
    border-color:                @selected;
    background-color:            transparent;
    text-color:                  transparent;
}
textbox {
    background-color:            inherit;
    text-color:                  inherit;
    vertical-align:              0.5;
    horizontal-align:            0.0;
}

/*****----- Listview -----*****/
listview {
    enabled:                     true;
    columns:                     6;
    lines:                       1;
    cycle:                       true;
    scrollbar:                   false;
    layout:                      vertical;
    padding:					 0px 0px 0px 3px;
    spacing:                     20px;
    background-color:            transparent;
    cursor:                      "default";
}

/*****----- Elements -----*****/
element {
    enabled:                     true;
    padding:                     10px 0px 17px 0px;
    border:                      0px solid;
    border-radius:               0px;
    border-color:                @selected;
    background-color:            transparent;
    text-color:                  @foreground;
    cursor:                      pointer;
}
element-text {
    font:                        "feather 12";
    background-color:            transparent;
    text-color:                  inherit;
    cursor:                      inherit;
    vertical-align:              0.5;
    horizontal-align:            0.5;
}

element normal.normal,
element alternate.normal {
    background-image:            url("~/.config/hypr/rofi/shared/power-button-normal.png", width);
    background-color:            transparent;
    text-color:                  #754c24;
}
element normal.urgent,
element alternate.urgent,
element selected.active {
    background-image:            url("~/.config/hypr/rofi/shared/power-button-normal.png", width);
    background-color:            transparent;
    text-color:                  #754c24;
}
element normal.active,
element alternate.active,
element selected.urgent {
    background-image:            url("~/.config/hypr/rofi/shared/power-button-normal.png", width);
    background-color:            transparent;
    text-color:                  #754c24;
}
element selected.normal {
    background-image:            url("~/.config/hypr/rofi/shared/power-button-select.png", width);
    background-color:            transparent;
    text-color:                  var(foreground);
}

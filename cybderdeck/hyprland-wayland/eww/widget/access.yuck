          :space-evenly "false"
          :vexpand "false"
          :hexpand "false"
          :halign "start"
          :valign "start"
          :spacing 1
          :class "blue-min-top-20"
          (label
            :class "blue-label"
            :halign "start"
            :text "/temp/"
          )
          (button
            :halign "center"
            :class "temp-icon"
            :onclick "eww close access-manager & thunar /var/temp"
            

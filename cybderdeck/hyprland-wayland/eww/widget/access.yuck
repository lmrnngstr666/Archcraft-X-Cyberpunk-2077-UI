
(defwidget main-bg []
  (box
    :orientation "v"
    :space-evenly "false"
    :vexpand "true"
    :hexpand "true"
    :halign "center"
    :class "main-bg"
  )
)

(defwidget access-manager-widget []
  (box
    :orientation "v"
    :space-evenly "false"
    :vexpand "false"
    :hexpand "false"
    :halign "center"
    :spacing 50
    
    (box
      :orientation "h"
      :space-evenly "true"
      :vexpand "false"
      :hexpand "false"
      :spacing 5
      :class "header"
      (box
        :orientation "h"
        :space-evenly "false"
        :vexpand "false"
        :hexpand "false"
        :spacing 5
        (image
          :path "./images/access/decor/access-icon.png"
          :image-width 25
          :image-height 27
          :halign "center"
          :class "access-icon"
          :valign "end"
        )
        (image
          :path "./images/access/decor/cyberdeck-logo-bin.png"
          :image-width 18
          :image-height 28
          :halign "center"
          :valign "end"
          :class "logo-bin"
        )
        (box
          :orientation "v"
          :space-evenly "false"
          :vexpand "false"
          :hexpand "false"
          :halign "start"
          :valign "end"
          :spacing 0
          :class "title-header"
          (label
            :text "CYBERDECK v.1.0.1"
            :halign "start"
            :valign "end"
            :class "titletop"
          )
          (label
            :text "ACCESS MANAGER"
            :halign "start"
            :valign "end"
            :class "title"
          )
        )
      )
      (box
        :orientation "h"
        :space-evenly "false"
        :vexpand "false"
        :hexpand "false"
        :halign "end"
        :valign "end"
        :spacing 5
        (image
          :path "./images/access/decor/protocol-icon.svg"
          :image-width 97
          :image-height 40
          :halign "end"
          :class "protocol-icon"
          :valign "end"
        )
      )
    )
    
    (box
      :orientation "v"
      :space-evenly "true"
      :vexpand "false"
      :spacing 42
      ; :valign "space-between"
      :hexpand "false"
      ; row one start
      (box
        :orientation "h"
        :space-evenly "false"
        :vexpand "false"
        :hexpand "false"
        :halign "center"
        :spacing 50
        :class "row-1"
        (box
          :orientation "v"
          :space-evenly "false"
          :vexpand "false"
          :hexpand "false"
          :halign "start"
          :valign "start"
          :spacing 1
          :class "blue-folder"
          (label
            :class "blue-label"
            :halign "start"
            :text "/cache/"
          )
          (button
            :halign "center"
            :class "cache-icon"
            :onclick "eww close access-manager & thunar /var/cache"
          )
        )
        (box
          :orientation "v"
          :space-evenly "false"
          :vexpand "false"
          :hexpand "false"
          :halign "start"
          :valign "start"
          :spacing 1
          :class "blue-min-top-20"
          (label
            :class "blue-label"
            :halign "start"
            :text "/log/"
          )
          (button
            :halign "center"
            :class "log-icon"
            :onclick "eww close access-manager & thunar /var/log"
          )
        )
        (box
          :orientation "v"
          :space-evenly "false"
          :vexpand "false"
          :hexpand "false"
          :halign "start"
          :valign "start"
          :spacing 1

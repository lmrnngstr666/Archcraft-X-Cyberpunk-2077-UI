(defwidget footer []
  (box
    :orientation "h"
    :space-evenly "false"
    :vexpand "false"
    :hexpand "false"
    :halign "end"
    :valign "end"
    :spacing 4
    :class "option"
    (image :path "./images/options/confirm.png"
      :image-width 24
      :image-height 24
      :halign "start"
      :class "options-icon"
    )
    (label
      :class "options-label"
      :halign "start"
      :text "SELECT"
    )
    (image :path "./images/options/close.png"
      :image-width 24
      :image-height 25
      :halign "start"
      :class "options-icon"
    )
    (button
      :onclick "eww close access-manager && eww close main-bg"
      (label
        :class "options-label"
        :halign "start"
        :text "CLOSE"
      )
    )
    
  )
)
